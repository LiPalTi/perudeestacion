# Copia este archivo como .env (en la misma carpeta que pom.xml) y completa tus datos de Supabase.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Supabase > Connect > JDBC > Session pooler. Copia el host que te muestre Supabase (puede ser aws-0 o aws-1,
# us-west-2, sa-east-1, etc.) y conserva los parametros del final:
#   sslmode=require        conexion cifrada
#   prepareThreshold=0     evita el error "prepared statement already exists" si alguna vez usas el puerto 6543
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
# Con el Session pooler el usuario es postgres.<referencia-del-proyecto>, no solo postgres.
DB_USER=postgres.abcdefghijklmnopqrst
# Evita la barra invertida (\) en la contrasena: en este archivo tiene un significado especial.
DB_PASSWORD=tu-contrasena-de-la-base-de-datos

# Clave para firmar los JWT: 32 caracteres o mas.
JWT_SECRET=reemplaza-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas

# Primer administrador (se crea solo al arrancar si no existe).
ADMIN_EMAIL=admin@perudeestacion.pe
ADMIN_PASSWORD=CambiaEstaClave2026

# Origenes permitidos por CORS (Angular en desarrollo y, luego, el dominio desplegado), separados por coma.
CORS_ORIGINS=http://localhost:4200

# Opcionales (valores por defecto entre parentesis):
# DB_AUTO_INIT=true        crea tablas y datos de prueba si la base esta vacia (true)
# DDL_AUTO=validate        comprueba entidades contra tablas al arrancar (none)
# JWT_EXPIRATION_MINUTES=60
