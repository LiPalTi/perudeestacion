      "name": "1. Publicos",
      "item": [
        {
          "name": "CP01 Listar departamentos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"Devuelve 25 departamentos (24 + Callao)\", () => pm.expect(d.length).to.eql(25));",
                  "const piu = d.find(x => x.codigo === \"PIU\");",
                  "pm.collectionVariables.set(\"piuId\", piu.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departamentos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "departamentos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "CP02 Temporadas Piura noviembre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Trae resultados\", () => pm.expect(r.resultados.length).to.be.above(0));",
                  "pm.test(\"Cada resultado trae imagenUrl (puede ser null)\", () => pm.expect(r.resultados[0]).to.have.property(\"imagenUrl\"));",
                  "pm.test(\"Ordenado: el primero es ALTA\", () => pm.expect(r.resultados[0].nivelTemporada).to.eql(\"ALTA\"));",
                  "pm.test(\"Incluye alerta El Nino vigente\", () => pm.expect(r.alertaVigente).to.not.be.null);",
                  "pm.test(\"Responde en menos de 1 s\", () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/temporadas?departamento=PIU&mes=11",
              "host": [
                "{{baseUrl}}"
